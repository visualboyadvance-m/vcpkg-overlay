+static errno_t xp_mbstowcs_s(size_t *ret, wchar_t *dst, size_t dstsz,
+                             const char *src, size_t max)
+{
+  size_t n;
+  if(!dst) {
+    n = mbstowcs(NULL, src, 0);
+    if(n == (size_t)-1)
+      return EILSEQ;
+    *ret = n + 1;
+    return 0;
+  }
+  if(!dstsz)
+    return EINVAL;
+  n = mbstowcs(dst, src, (max < dstsz) ? max : dstsz - 1);
+  if(n == (size_t)-1)
+    return EILSEQ;
+  dst[n] = 0;
+  *ret = n + 1;
+  return 0;
+}
+
+static errno_t xp_wcstombs_s(size_t *ret, char *dst, size_t dstsz,
+                             const wchar_t *src, size_t max)
+{
+  size_t n;
+  if(!dst) {
+    n = wcstombs(NULL, src, 0);
+    if(n == (size_t)-1)
+      return EILSEQ;
+    *ret = n + 1;
+    return 0;
+  }
+  if(!dstsz)
+    return EINVAL;
+  n = wcstombs(dst, src, (max < dstsz) ? max : dstsz - 1);
+  if(n == (size_t)-1)
+    return EILSEQ;
+  dst[n] = 0;
+  *ret = n + 1;
+  return 0;
+}
+
+static errno_t xp_wcsncpy_s(wchar_t *dst, size_t dstsz,
+                            const wchar_t *src, size_t count)
+{
+  size_t n = wcslen(src);
+  if(n > count)
+    n = count;
+  if(!dst || n >= dstsz)
+    return ERANGE;
+  memcpy(dst, src, n * sizeof(wchar_t));
+  dst[n] = 0;
+  return 0;
+}
+
+static errno_t xp_wcscpy_s(wchar_t *dst, size_t dstsz, const wchar_t *src)
+{
+  size_t n = wcslen(src);
+  if(!dst || n >= dstsz)
+    return ERANGE;
+  memcpy(dst, src, (n + 1) * sizeof(wchar_t));
+  return 0;
