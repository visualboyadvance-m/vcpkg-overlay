+#ifdef CURL_WINDOWS_XP
+
+void Curl_cond_init(curl_cond_t *c)
+{
+  InitializeCriticalSection(&c->lock);
+  c->sema = CreateSemaphore(NULL, 0, LONG_MAX, NULL);
+  c->waiters = 0;
+}
+
+void Curl_cond_destroy(curl_cond_t *c)
+{
+  if(c->sema) {
+    CloseHandle(c->sema);
+    c->sema = NULL;
+  }
+  DeleteCriticalSection(&c->lock);
+}
+
+void Curl_cond_signal(curl_cond_t *c)
+{
+  EnterCriticalSection(&c->lock);
+  if(c->waiters > 0) {
+    /* hand exactly one token to one waiter */
+    c->waiters--;
+    ReleaseSemaphore(c->sema, 1, NULL);
+  }
+  LeaveCriticalSection(&c->lock);
+}
+
+/* Returns WAIT_OBJECT_0 when signalled, WAIT_TIMEOUT or WAIT_FAILED */
+static DWORD cond_wait_ms(curl_cond_t *c, CRITICAL_SECTION *m, DWORD ms)
+{
+  DWORD rc;
+
+  if(!c->sema)
+    return WAIT_FAILED;
+
+  EnterCriticalSection(&c->lock);
+  c->waiters++;
+  LeaveCriticalSection(&c->lock);
+
+  LeaveCriticalSection(m);
+  rc = WaitForSingleObject(c->sema, ms);
+
+  if(rc != WAIT_OBJECT_0) {
+    EnterCriticalSection(&c->lock);
+    /* A signal may have arrived between the timeout and taking the lock.
+       If so, a token is waiting for us and our waiter count is already
+       gone: consume it and report success. Otherwise unregister. */
+    if(WaitForSingleObject(c->sema, 0) == WAIT_OBJECT_0)
+      rc = WAIT_OBJECT_0;
+    else
+      c->waiters--;
+    LeaveCriticalSection(&c->lock);
+  }
+
+  EnterCriticalSection(m);
+  return rc;
+}
+
+void Curl_cond_wait(curl_cond_t *c, CRITICAL_SECTION *m)
+{
+  (void)cond_wait_ms(c, m, INFINITE);
+}
+
+CURLcode Curl_cond_timedwait(curl_cond_t *c, CRITICAL_SECTION *m,
+                             uint32_t timeout_ms)
+{
+  DWORD rc = cond_wait_ms(c, m, (DWORD)timeout_ms);
+  if(rc == WAIT_OBJECT_0)
+    return CURLE_OK;
+  return (rc == WAIT_TIMEOUT) ?
+         CURLE_OPERATION_TIMEDOUT : CURLE_UNRECOVERABLE_POLL;
+}
+
+#else /* !CURL_WINDOWS_XP */
