+/*
+ * Portable stand-in for inet_pton(), which Windows only provides from
+ * Vista onwards (not available when building for Windows XP).
+ * Returns 1 on success, 0 if |str| is not a valid address of |family|.
+ */
+static int test_pton(int family, const char *str, unsigned char *out)
+{
+    ASN1_OCTET_STRING *a = a2i_IPADDRESS(str);
+    size_t want = (family == AF_INET) ? 4 : 16;
+    int ok = 0;
+
+    if (a != NULL && ASN1_STRING_get_length(a) == want) {
+        memcpy(out, ASN1_STRING_get0_data(a), want);
+        ok = 1;
+    }
+    ASN1_OCTET_STRING_free(a);
+    return ok;
+}
