diff --git a/Configurations/50-mingw-xp.conf b/Configurations/50-mingw-xp.conf
new file mode 100644
index 0000000..57deb1a
--- /dev/null
+++ b/Configurations/50-mingw-xp.conf
@@ -0,0 +1,34 @@
+## -*- mode: perl; -*-
+## Windows XP (NT 5.1) target, cross-compiled with the i686-pc-mingw32
+## (mingw-w64) toolchain.
+##
+## Usage:
+##     ./Configure mingw-xp --cross-compile-prefix=i686-pc-mingw32-
+##
+## What differs from the stock "mingw" target:
+##   * _WIN32_WINNT/WINVER are pinned to 0x0501 so that no Vista+ API
+##     (SRWLOCK, condition variables, InitOnce*, BCrypt*, ...) is selected
+##     at compile time.  include/internal/e_os.h would otherwise default to
+##     0x0600.
+##   * BCrypt is disabled: OPENSSL_WIN32_NO_BCRYPT forces rand_win.c onto
+##     the CryptoAPI (CryptGenRandom) seeding path and -lbcrypt is not
+##     linked, so nothing imports bcrypt.dll (which XP does not have).
+##   * Uses the Universal CRT (-mcrtdll=ucrt, ucrtbase.dll + api-ms-win-crt-*).
+##     XP has no UCRT out of the box: install the Visual C++ 2015-2019
+##     redistributable (x86, 14.27 or older still supports XP SP3) or deploy
+##     the UCRT DLLs app-local.  time_t is 64-bit.
+##   * PE OS/subsystem version 5.1 so the loader accepts the binaries.
+
+my %targets = (
+    "mingw-xp" => {
+        inherit_from     => [ "mingw" ],
+        cflags           => add("-mcrtdll=ucrt"),
+        cppflags         => add("-D_WIN32_WINNT=0x0501 -DWINVER=0x0501",
+                                "-DOPENSSL_WIN32_NO_BCRYPT"),
+        lflags           => add("-mcrtdll=ucrt",
+                                "-Wl,--major-os-version,5,--minor-os-version,1",
+                                "-Wl,--major-subsystem-version,5,--minor-subsystem-version,1"),
+        ex_libs          => "-lws2_32 -lgdi32 -lcrypt32",
+        shared_ldflag    => add("-mcrtdll=ucrt"),
+    },
+);
diff --git a/NOTES-WINDOWS.md b/NOTES-WINDOWS.md
index a7889cd..87f3796 100644
--- a/NOTES-WINDOWS.md
+++ b/NOTES-WINDOWS.md
@@ -242,6 +242,19 @@ MinGW offers an alternative way to build native OpenSSL, by cross compilation.
    This requires that you've installed the necessary add-on packages for
    mingw[64] cross compilation.
 
+ * Windows XP (NT 5.1) is supported through the `mingw-xp` target:
+
+       ./Configure mingw-xp --cross-compile-prefix=i686-pc-mingw32- ...
+
+   It pins `_WIN32_WINNT`/`WINVER` to `0x0501`, disables BCrypt
+   (`OPENSSL_WIN32_NO_BCRYPT`; seeding uses CryptoAPI `CryptGenRandom` and
+   `bcrypt.dll` is never linked), links against the Universal CRT
+   (`-mcrtdll=ucrt`, 64-bit `time_t`), and stamps the PE headers with
+   OS/subsystem version 5.1.  XP does not ship the UCRT: install the
+   Visual C++ 2015-2019 x86 redistributable (14.27 or older still installs
+   on XP SP3) or deploy the UCRT DLLs app-local.  Applications must also be
+   built against UCRT.
+
