diff -u -r a/src/msw/radiobox.cpp b/src/msw/radiobox.cpp
--- a/src/msw/radiobox.cpp	2026-11-19 18:09:49.064364400 +0000
+++ b/src/msw/radiobox.cpp	2026-11-19 18:11:22.465468300 +0000
@@ -532,4 +532,31 @@
     }
 }
 
+// ----------------------------------------------------------------------------
+// out of line to keep its thunks out of a COMDAT group
+// ----------------------------------------------------------------------------
+
+// The definitions below are trivial one liners that belong in the header and
+// were written there until this patch. They cannot stay there. Each overrides
+// a virtual that is declared in more than one base class, so GCC emits a
+// non-virtual thunk at a different `this' adjustment per base. Its LTO writer
+// names a thunk's COMDAT group after the target function rather than after
+// each thunk, so two objects needing different subsets of the thunks produce
+// same-named groups holding different symbols. The PE linker then discards one
+// group and the references into it dangle:
+//
+//   `__ZThn428_NK10wxTextCtrl7HitTestERK7wxPointPlS3_' referenced in section
+//   `.rdata': defined in discarded section
+//   `.gnu.linkonce.t._ZNK10wxTextCtrl7HitTestERK7wxPointPlS3_'
+//
+// That is GCC PR 94156, MinGW-only and open since 2020. Defined out of line
+// there is no COMDAT group at all, so there is nothing to discard: one
+// definition of each thunk lives here and every other translation unit just
+// refers to it.
+
+int wxRadioBox::GetSelection() const
+{
+    return m_selectedButton;
+}
+
 #endif // wxUSE_RADIOBOX
