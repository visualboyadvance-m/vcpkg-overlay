diff -u -r a/src/common/textcmn.cpp b/src/common/textcmn.cpp
--- a/src/common/textcmn.cpp	2026-11-19 18:09:48.026056300 +0000
+++ b/src/common/textcmn.cpp	2026-11-19 18:11:22.463466500 +0000
@@ -913,6 +913,51 @@
     return true;
 }
 
+// GetValue() and SetValue() override a virtual function inherited from two
+// different base classes at once -- wxTextAreaBase and wxTextEntry -- so the
+// compiler emits two non-virtual thunks for each of them, one per base, at two
+// different "this" adjustments.
+//
+// If they were defined inline in the header, as they used to be, every
+// translation unit would emit them into a COMDAT group keyed by the function
+// itself, with both thunks inside it. GCC's LTO writer names that group after
+// the target function rather than after each thunk, so two objects that need
+// different subsets of the thunks end up with same-named groups holding
+// different symbols, and the PE linker rejects them as multiple definitions
+// (GCC PR 94156, which is MinGW-only and still open). Defining them here
+// instead leaves a single definition of each thunk in this object, and every
+// other translation unit simply refers to it.
+wxString wxTextCtrlBase::GetValue() const
+{
+    return wxTextEntry::GetValue();
+}
+
+void wxTextCtrlBase::SetValue(const wxString& value)
+{
+    wxTextEntry::SetValue(value);
+}
+
+bool wxTextCtrlBase::IsValidPosition(long pos) const
+{
+    return pos >= 0 && pos <= GetLastPosition();
+}
+
+wxWindow *wxTextCtrlBase::GetEditableWindow()
+{
+    return this;
+}
+
+// Out of line for the same reason, see above.
+wxString wxTextCtrlIface::GetValue() const
+{
+    return wxTextEntryBase::GetValue();
+}
+
+void wxTextCtrlIface::SetValue(const wxString& value)
+{
+    wxTextEntryBase::SetValue(value);
+}
+
 // apply styling to text range
 bool wxTextCtrlBase::SetStyle(long WXUNUSED(start), long WXUNUSED(end),
                               const wxTextAttr& WXUNUSED(style))
