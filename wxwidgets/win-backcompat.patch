+// DTTOPTS and the associated callback type are only defined by the SDK headers
+// when targeting Vista or later, but we still use the type (e.g. with
+// DrawThemeTextEx() loaded dynamically) when building for XP, so define it here.
+typedef int (WINAPI * DTT_CALLBACK_PROC)(HDC hdc, LPWSTR pszText, int cchText,
+                                         LPRECT prc, UINT dwFlags,
+                                         LPARAM lParam);
+
+typedef struct _DTTOPTS
+{
+    DWORD             dwSize;
+    DWORD             dwFlags;
+    COLORREF          crText;
+    COLORREF          crBorder;
+    COLORREF          crShadow;
+    int               iTextShadowType;
+    POINT             ptShadowOffset;
+    int               iBorderSize;
+    int               iFontPropId;
+    int               iColorPropId;
+    int               iStateId;
+    BOOL              fApplyOverlay;
+    int               iGlowSize;
+    DTT_CALLBACK_PROC pfnDrawTextCallback;
+    LPARAM            lParam;
+} DTTOPTS, *PDTTOPTS;
