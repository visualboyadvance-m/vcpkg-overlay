diff --git a/include/wx/msw/chkconf.h b/include/wx/msw/chkconf.h
index 143a9c7870..d7adf76e82 100644
--- a/include/wx/msw/chkconf.h
+++ b/include/wx/msw/chkconf.h
@@ -174,6 +174,27 @@
 #   endif
 #endif
 
+/* Disable the features which can't work at all when building for a pre-Vista
+   system such as Windows XP (_WIN32_WINNT < 0x0600). This is only done when
+   _WIN32_WINNT is explicitly defined, as an undefined value would be treated
+   as 0 here and wrongly disable them. */
+#if defined(_WIN32_WINNT) && (_WIN32_WINNT < 0x0600)
+    /* The native progress dialog uses the task dialog API, which is only
+       available under Vista and later, so use the generic version instead. */
+#   undef wxUSE_NATIVE_PROGRESSDLG
+#   define wxUSE_NATIVE_PROGRESSDLG 0
+
+    /* WebView2 requires Windows 7 or later and its SDK headers can't even be
+       compiled when targeting an earlier system. */
+#   undef wxUSE_WEBVIEW_EDGE
+#   define wxUSE_WEBVIEW_EDGE 0
+
+    /* Similarly, WinRT itself requires Vista and the WRL headers used to
+       access it explicitly refuse to compile for the earlier systems. */
+#   undef wxUSE_WINRT
+#   define wxUSE_WINRT 0
+#endif
+
 /* wxMSW-specific checks: notice that this file is also used with wxUniv
    and can even be used with wxGTK, when building it under Windows.
  */
diff --git a/include/wx/msw/private/backcompat.h b/include/wx/msw/private/backcompat.h
new file mode 100644
index 0000000000..afa83c93b7
--- /dev/null
+++ b/include/wx/msw/private/backcompat.h
@@ -0,0 +1,196 @@
+/////////////////////////////////////////////////////////////////////////////
+// Name:        wx/msw/private/backcompat.h
+// Purpose:     Cached run-time lookup of functions missing under older systems
+// Author:      Rafael Kitover
+// Copyright:   (c) 2026 Rafael Kitover
+// Licence:     wxWindows licence
+/////////////////////////////////////////////////////////////////////////////
+
+#ifndef WX_MSW_PRIVATE_BACKCOMPAT_H_
+#define WX_MSW_PRIVATE_BACKCOMPAT_H_
+
+#include "wx/dynlib.h"
+#include "wx/msw/private.h"
+
+// ----------------------------------------------------------------------------
+// wxMSWBackCompat
+// ----------------------------------------------------------------------------
+
+// Functions which don't exist on every system wx can still be built for.
+// Importing one of them statically stops the binary from loading at all on a
+// system without it -- not just when the function is called -- so they have to
+// be resolved at run time. This does it once, on first use, and caches both
+// the library handles and the addresses.
+//
+// There are two kinds of member here:
+//
+//  - Methods, for a function with a usable older equivalent. They call the
+//    newer function where it exists and fall back where it doesn't, so the
+//    caller needs no version check of its own and no knowledge that anything
+//    is being resolved dynamically.
+//
+//  - Function pointers, for a function with no equivalent. These are null when
+//    the function is missing and must be checked before being called. They are
+//    deliberately not wrapped: there is no older call to forward to, and the
+//    caller generally has to take a different path rather than a different
+//    call.
+//
+// Use Get() to reach the single instance, which is created on first use and
+// then lives until the process exits.
+
+class wxMSWBackCompat
+{
+public:
+    static const wxMSWBackCompat& Get()
+    {
+        static const wxMSWBackCompat s_instance;
+        return s_instance;
+    }
+
+    // ------------------------------------------------------------------------
+    // Wrapped: the caller needs no version check
+    // ------------------------------------------------------------------------
+
+    // Cancel pending I/O on the given handle.
+    //
+    // CancelIoEx() is Vista or later. Before it, only the calling thread's I/O
+    // on the handle can be cancelled, so a read issued by another thread stays
+    // pending and a caller waiting for completion waits longer.
+    BOOL CancelIoEx(HANDLE handle, OVERLAPPED* overlapped) const
+    {
+        if ( m_pfnCancelIoEx )
+            return m_pfnCancelIoEx(handle, overlapped);
+
+        return ::CancelIo(handle);
+    }
+
+    // Delete a registry key in the given registry view.
+    //
+    // RegDeleteKeyEx() is Vista or later. Before it the view can't be chosen
+    // and the default one is always used.
+    LONG DeleteRegKey(HKEY key, const wxChar* subkey, REGSAM view) const
+    {
+        if ( m_pfnRegDeleteKeyEx )
+            return m_pfnRegDeleteKeyEx(key, subkey, view, 0);
+
+        return ::RegDeleteKey(key, subkey);
+    }
+
+    // Retrieve the product type of the running system.
+    //
+    // GetProductInfo() is Vista or later. Before it there is nothing to ask,
+    // so this returns FALSE and leaves productType alone, exactly as the real
+    // function does when it fails.
+    BOOL GetProductInfo(DWORD verMajor, DWORD verMinor,
+                        DWORD spMajor, DWORD spMinor,
+                        PDWORD productType) const
+    {
+        if ( !m_pfnGetProductInfo )
+            return FALSE;
+
+        return m_pfnGetProductInfo(verMajor, verMinor,
+                                   spMajor, spMinor, productType);
+    }
+
+    // Set the AppUserModelID used to group this process's windows in the
+    // taskbar.
+    //
+    // SetCurrentProcessExplicitAppUserModelID() is exported by shell32 since
+    // Windows 7. Before it there is no taskbar grouping to configure, so this
+    // does nothing.
+    void SetAppUserModelID(const wxString& id) const
+    {
+        if ( m_pfnSetAppUserModelID )
+            m_pfnSetAppUserModelID(id.wc_str());
+    }
+
+    // ------------------------------------------------------------------------
+    // Unwrapped: null when missing, check before calling
+    // ------------------------------------------------------------------------
+
+    // These NLS functions take a locale *name*; their predecessors take an
+    // LCID and can't express everything a name can, so a caller that wants to
+    // keep working without them has to do more than call something else --
+    // notably, an explicitly specified locale can't be honoured at all.
+    typedef int  (WINAPI *GetLocaleInfoEx_t)(LPCWSTR, LCTYPE, LPWSTR, int);
+    typedef int  (WINAPI *GetUserDefaultLocaleName_t)(LPWSTR, int);
+    typedef BOOL (WINAPI *GetUserPreferredUILanguages_t)(DWORD, PULONG,
+                                                         PZZWSTR, PULONG);
+    typedef BOOL (WINAPI *SetThreadPreferredUILanguages_t)(DWORD, PCZZWSTR,
+                                                           PULONG);
+    typedef int  (WINAPI *CompareStringEx_t)(LPCWSTR, DWORD, LPCWCH, int,
+                                             LPCWCH, int, LPNLSVERSIONINFO,
+                                             LPVOID, LPARAM);
+
+    GetLocaleInfoEx_t               GetLocaleInfoEx;
+    GetUserDefaultLocaleName_t      GetUserDefaultLocaleName;
+    GetUserPreferredUILanguages_t   GetUserPreferredUILanguages;
+    SetThreadPreferredUILanguages_t SetThreadPreferredUILanguages;
+    CompareStringEx_t               CompareStringEx;
+
+private:
+    typedef BOOL    (WINAPI *CancelIoEx_t)(HANDLE, LPOVERLAPPED);
+    typedef LONG    (WINAPI *RegDeleteKeyEx_t)(HKEY, const wxChar*,
+                                               REGSAM, DWORD);
+    typedef BOOL    (WINAPI *GetProductInfo_t)(DWORD, DWORD, DWORD, DWORD,
+                                               PDWORD);
+    typedef HRESULT (WINAPI *SetAppUserModelID_t)(PCWSTR);
+
+    wxMSWBackCompat()
+    {
+        // kernel32 and advapi32 are always already loaded and are never
+        // unloaded, so the addresses stay good after these go out of scope:
+        // wxLoadedDLL detaches rather than freeing.
+        {
+            wxLoadedDLL dllKernel32(wxS("kernel32.dll"));
+
+            m_pfnCancelIoEx = (CancelIoEx_t)
+                dllKernel32.RawGetSymbol("CancelIoEx");
+            m_pfnGetProductInfo = (GetProductInfo_t)
+                dllKernel32.RawGetSymbol("GetProductInfo");
+
+            GetLocaleInfoEx = (GetLocaleInfoEx_t)
+                dllKernel32.RawGetSymbol("GetLocaleInfoEx");
+            GetUserDefaultLocaleName = (GetUserDefaultLocaleName_t)
+                dllKernel32.RawGetSymbol("GetUserDefaultLocaleName");
+            GetUserPreferredUILanguages = (GetUserPreferredUILanguages_t)
+                dllKernel32.RawGetSymbol("GetUserPreferredUILanguages");
+            SetThreadPreferredUILanguages = (SetThreadPreferredUILanguages_t)
+                dllKernel32.RawGetSymbol("SetThreadPreferredUILanguages");
+            CompareStringEx = (CompareStringEx_t)
+                dllKernel32.RawGetSymbol("CompareStringEx");
+        }
+
+        {
+            wxLoadedDLL dllAdvapi32(wxS("advapi32.dll"));
+
+            // wx is Unicode-only, so this is always the W entry point, but
+            // spell it out: RegDeleteKeyEx is a macro and would otherwise be
+            // expanded inside the string by some SDKs.
+            m_pfnRegDeleteKeyEx = (RegDeleteKeyEx_t)
+                dllAdvapi32.RawGetSymbol("RegDeleteKeyExW");
+        }
+
+        // shell32, unlike the above, need not be loaded already -- a console
+        // application may never have touched it -- so load it for real and
+        // keep it, since the address has to outlive this constructor.
+        if ( m_dllShell32.Load(wxS("shell32.dll"),
+                               wxDL_VERBATIM | wxDL_QUIET) )
+        {
+            m_pfnSetAppUserModelID = (SetAppUserModelID_t)
+                m_dllShell32.RawGetSymbol(
+                    "SetCurrentProcessExplicitAppUserModelID");
+        }
+    }
+
+    CancelIoEx_t        m_pfnCancelIoEx = nullptr;
+    RegDeleteKeyEx_t    m_pfnRegDeleteKeyEx = nullptr;
+    GetProductInfo_t    m_pfnGetProductInfo = nullptr;
+    SetAppUserModelID_t m_pfnSetAppUserModelID = nullptr;
+
+    wxDynamicLibrary m_dllShell32;
+
+    wxDECLARE_NO_COPY_CLASS(wxMSWBackCompat);
+};
+
+#endif // WX_MSW_PRIVATE_BACKCOMPAT_H_
diff --git a/include/wx/msw/private/backcompatgui.h b/include/wx/msw/private/backcompatgui.h
new file mode 100644
index 0000000000..831658369c
--- /dev/null
+++ b/include/wx/msw/private/backcompatgui.h
@@ -0,0 +1,76 @@
+/////////////////////////////////////////////////////////////////////////////
+// Name:        wx/msw/private/backcompatgui.h
+// Purpose:     wxMSWBackCompat's counterpart for GUI-only libraries
+// Author:      Rafael Kitover
+// Copyright:   (c) 2026 Rafael Kitover
+// Licence:     wxWindows licence
+/////////////////////////////////////////////////////////////////////////////
+
+#ifndef WX_MSW_PRIVATE_BACKCOMPATGUI_H_
+#define WX_MSW_PRIVATE_BACKCOMPATGUI_H_
+
+#include "wx/dynlib.h"
+#include "wx/msw/uxtheme.h"
+
+// ----------------------------------------------------------------------------
+// wxMSWBackCompatGUI
+// ----------------------------------------------------------------------------
+
+// The same thing as wxMSWBackCompat, and used the same way, for the libraries
+// only the GUI links against. It is separate because wxBase must not pull in
+// uxtheme.h and the types these functions are declared in terms of.
+//
+// See wx/msw/private/backcompat.h for what the two kinds of member mean.
+
+class wxMSWBackCompatGUI
+{
+public:
+    static const wxMSWBackCompatGUI& Get()
+    {
+        static const wxMSWBackCompatGUI s_instance;
+        return s_instance;
+    }
+
+    // Draw themed text, honouring the extended options in pOptions.
+    //
+    // DrawThemeTextEx() is Vista or later. Before it the extended options are
+    // lost -- notably the text colour possibly given in DTTOPTS is not
+    // honoured -- but the text is still drawn.
+    HRESULT DrawThemeTextEx(HTHEME hTheme, HDC hdc, int iPartId, int iStateId,
+                            const wchar_t* pszText, int cchText,
+                            DWORD dwTextFlags, RECT* pRect,
+                            const DTTOPTS* pOptions) const
+    {
+        if ( m_pfnDrawThemeTextEx )
+        {
+            return m_pfnDrawThemeTextEx(hTheme, hdc, iPartId, iStateId,
+                                        pszText, cchText, dwTextFlags,
+                                        pRect, pOptions);
+        }
+
+        return ::DrawThemeText(hTheme, hdc, iPartId, iStateId, pszText,
+                               cchText, dwTextFlags, 0, pRect);
+    }
+
+private:
+    typedef HRESULT (WINAPI *DrawThemeTextEx_t)(HTHEME, HDC, int, int, LPCWSTR,
+                                                int, DWORD, LPRECT,
+                                                const DTTOPTS*);
+
+    wxMSWBackCompatGUI()
+    {
+        // Nothing here is reached before the theme API is in use, so uxtheme
+        // is loaded by now and wxLoadedDLL finds it. It is not unloaded while
+        // we run, so the address outlives this scope.
+        wxLoadedDLL dllUxTheme(wxS("uxtheme.dll"));
+
+        m_pfnDrawThemeTextEx = (DrawThemeTextEx_t)
+            dllUxTheme.RawGetSymbol("DrawThemeTextEx");
+    }
+
+    DrawThemeTextEx_t m_pfnDrawThemeTextEx = nullptr;
+
+    wxDECLARE_NO_COPY_CLASS(wxMSWBackCompatGUI);
+};
+
+#endif // WX_MSW_PRIVATE_BACKCOMPATGUI_H_
