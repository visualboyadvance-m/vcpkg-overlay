diff --git a/include/wx/msw/chkconf.h b/include/wx/msw/chkconf.h
index 143a9c7870..d7adf76e82 100644
--- a/include/wx/msw/chkconf.h
+++ b/include/wx/msw/chkconf.h
@@ -174,6 +174,27 @@
 #   endif
 #endif
 
+/* Disable the features which can't work at all when building for a pre-Vista
+   system such as Windows XP (_WIN32_WINNT < 0x0600). This is only done when
+   _WIN32_WINNT is explicitly defined, as an undefined value would be treated
+   as 0 here and wrongly disable them. */
+#if defined(_WIN32_WINNT) && (_WIN32_WINNT < 0x0600)
+    /* The native progress dialog uses the task dialog API, which is only
+       available under Vista and later, so use the generic version instead. */
+#   undef wxUSE_NATIVE_PROGRESSDLG
+#   define wxUSE_NATIVE_PROGRESSDLG 0
+
+    /* WebView2 requires Windows 7 or later and its SDK headers can't even be
+       compiled when targeting an earlier system. */
+#   undef wxUSE_WEBVIEW_EDGE
+#   define wxUSE_WEBVIEW_EDGE 0
+
+    /* Similarly, WinRT itself requires Vista and the WRL headers used to
+       access it explicitly refuse to compile for the earlier systems. */
+#   undef wxUSE_WINRT
+#   define wxUSE_WINRT 0
+#endif
+
 /* wxMSW-specific checks: notice that this file is also used with wxUniv
    and can even be used with wxGTK, when building it under Windows.
  */
