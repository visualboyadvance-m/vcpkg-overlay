--- a/src/msw/app.cpp
+++ b/src/msw/app.cpp
@@ -501,9 +501,21 @@ bool wxApp::Initialize(int& argc_, wxChar **argv_)
     const wxString className(wxTheApp->GetClassName());
     if ( !className.empty() )
     {
-        SetCurrentProcessExplicitAppUserModelID(className.wc_str());
+        // SetCurrentProcessExplicitAppUserModelID() is exported by shell32.dll
+        // since Windows 7 only, so load it dynamically to still run under XP.
+        typedef HRESULT (WINAPI *SetCurrentProcessExplicitAppUserModelID_t)(PCWSTR);
+
+        wxDynamicLibrary dllShell32(wxS("shell32.dll"), wxDL_VERBATIM | wxDL_QUIET);
+        SetCurrentProcessExplicitAppUserModelID_t
+            wxDL_INIT_FUNC(pfn, SetCurrentProcessExplicitAppUserModelID, dllShell32);
+        if ( pfnSetCurrentProcessExplicitAppUserModelID )
+            pfnSetCurrentProcessExplicitAppUserModelID(className.wc_str());
     }
 
+    // Using comctl32.dll v6 is not required when building for Windows XP: it
+    // is available there, but the features relying on it (notably the task
+    // dialogs) are compiled out anyhow, so don't nag about the manifest.
+#if _WIN32_WINNT >= 0x0600
     if ( !wxSystemOptions::GetOptionInt("msw.no-manifest-check") )
     {
         if ( GetComCtl32Version() < 610 )
@@ -542,6 +554,7 @@ if you believe not using the manifest should remain supported.
             );
         }
     }
+#endif // _WIN32_WINNT >= 0x0600
 
     return true;
 }
